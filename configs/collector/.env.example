# Copy to .env (gitignored) and fill in real values.
# Only vars needed by the config you're running have to be set; the
# Collector fails at startup if an *active* exporter's endpoint is empty.

BRAINTRUST_OTLP_ENDPOINT=https://api.braintrust.dev/otel
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=

# Only needed if you point FLOWTEL_COLLECTOR_CONFIG at flowtel.yaml
# (the full multi-backend config) instead of the braintrust-only default.
PHOENIX_OTLP_ENDPOINT=
LAMINAR_OTLP_ENDPOINT=
GREPTIME_OTLP_ENDPOINT=
PARSEABLE_OTLP_ENDPOINT=
